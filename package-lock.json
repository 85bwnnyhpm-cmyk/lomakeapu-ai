import { useState, useEffect } from 'react';
import { useAuth } from '@/contexts/AuthContext';
import { supabase, Analysis } from '@/lib/supabase';
import { ArrowLeft, FileText, Clock, Trash2, Sparkles, ListChecks, ClipboardPen } from 'lucide-react';

export default function HistoryPage({ onBack }: { onBack: () => void }) {
  const { user } = useAuth();
  const [items, setItems] = useState<Analysis[]>([]);
  const [loading, setLoading] = useState(true);
  const [selected, setSelected] = useState<Analysis | null>(null);

  useEffect(() => {
    if (!user) return;
    supabase
      .from('analyses')
      .select('*')
      .eq('user_id', user.id)
      .order('created_at', { ascending: false })
      .then(({ data, error }) => {
        if (!error && data) setItems(data as Analysis[]);
        setLoading(false);
      });
  }, [user]);

  async function handleDelete(id: string) {
    const prev = items;
    setItems(items.filter((i) => i.id !== id));
    if (selected?.id === id) setSelected(null);
    const { error } = await supabase.from('analyses').delete().eq('id', id);
    if (error) setItems(prev);
  }

  return (
    <div className="min-h-screen gradient-hero">
      <header className="sticky top-0 z-20 bg-white/90 backdrop-blur-md border-b border-brand-border">
        <div className="w-full max-w-[1120px] mx-auto px-5 flex items-center justify-between h-16">
          <button
            onClick={onBack}
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold text-brand-text border border-brand-border bg-white hover:border-primary-600 hover:text-primary-600 transition-all"
          >
            <ArrowLeft size={16} /> Takaisin
          </button>
          <div className="flex items-center gap-2">
            <div className="w-9 h-9 rounded-xl bg-primary-600 flex items-center justify-center">
              <Sparkles size={18} className="text-white" />
            </div>
            <span className="font-extrabold text-brand-text">LomakeApu AI</span>
          </div>
        </div>
      </header>

      <main className="w-full max-w-[1120px] mx-auto px-5 py-10">
        <h1 className="text-2xl md:text-[2rem] font-extrabold text-brand-text mb-1">Historia</h1>
        <p className="text-brand-muted mb-6">Kaikki analysoimasi asiakirjat.</p>

        {loading ? (
          <p className="text-brand-muted">Ladataan...</p>
        ) : items.length === 0 ? (
          <div className="rounded-card bg-white border border-brand-border shadow-card p-10 text-center">
            <div className="w-14 h-14 rounded-2xl bg-primary-50 flex items-center justify-center mx-auto mb-3">
              <FileText size={26} className="text-primary-600" />
            </div>
            <p className="text-brand-text font-semibold">Ei vielä analyyssejä</p>
            <p className="text-brand-muted text-sm mt-1">Analysoi ensimmäinen asiakirja nähdäksesi sen täällä.</p>
          </div>
        ) : (
          <div className="grid lg:grid-cols-[340px_1fr] gap-6">
            {/* List */}
            <div className="space-y-2.5">
              {items.map((it) => (
                <button
                  key={it.id}
                  onClick={() => setSelected(it)}
                  className={`w-full text-left rounded-xl border p-4 transition-all duration-150 ${
                    selected?.id === it.id
                      ? 'border-primary-600 bg-primary-50'
                      : 'border-brand-border bg-white hover:border-primary-200'
                  }`}
                >
                  <div className="flex items-center gap-2 mb-1">
                    <FileText size={15} className="text-primary-600 shrink-0" />
                    <span className="font-semibold text-brand-text text-sm truncate">
                      {it.filename || 'Liitetty teksti'}
                    </span>
                  </div>
                  <div className="flex items-center gap-1.5 text-xs text-brand-muted">
                    <Clock size={12} />
                    {new Date(it.created_at).toLocaleString('fi-FI', {
                      day: 'numeric', month: 'numeric', year: 'numeric',
                      hour: '2-digit', minute: '2-digit',
                    })}
                  </div>
                </button>
              ))}
            </div>

            {/* Detail */}
            <div className="rounded-card bg-white border border-brand-border shadow-card p-6">
              {!selected ? (
                <div className="flex flex-col items-center justify-center h-full text-center py-16">
                  <div className="w-14 h-14 rounded-2xl bg-primary-50 flex items-center justify-center mb-3">
                    <FileText size={26} className="text-primary-600" />
                  </div>
                  <p className="text-brand-muted text-sm">Valitse asiakirja vasemmalta nähdäksesi analyysin.</p>
                </div>
              ) : (
                <div className="space-y-5">
                  <div className="flex items-start justify-between gap-3">
                    <div>
                      <h2 className="font-bold text-brand-text">{selected.filename || 'Liitetty teksti'}</h2>
                      <p className="text-xs text-brand-muted mt-0.5">
                        {new Date(selected.created_at).toLocaleString('fi-FI')}
                      </p>
                    </div>
                    <button
                      onClick={() => handleDelete(selected.id)}
                      className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold text-red-600 border border-red-200 hover:bg-red-50 transition-colors"
                    >
                      <Trash2 size={13} /> Poista
                    </button>
                  </div>

                  <div>
                    <div className="flex items-center gap-2 mb-2">
                      <Sparkles size={17} className="text-primary-600" />
                      <h3 className="font-bold text-brand-text">Selkosuomi</h3>
                    </div>
                    <p className="text-sm text-brand-text leading-relaxed whitespace-pre-wrap">
                      {selected.explanation}
                    </p>
                  </div>

                  {selected.key_points.length > 0 && (
                    <div>
                      <div className="flex items-center gap-2 mb-2">
                        <ListChecks size={17} className="text-primary-600" />
                        <h3 className="font-bold text-brand-text">Avainkohdat</h3>
                      </div>
                      <ul className="space-y-1.5">
                        {selected.key_points.map((p, i) => (
                          <li key={i} className="text-sm text-brand-text">• {p}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {selected.action_items.length > 0 && (
                    <div>
                      <div className="flex items-center gap-2 mb-2">
                        <ArrowLeft size={17} className="text-primary-600 rotate-180" />
                        <h3 className="font-bold text-brand-text">Mitä tehdä seuraavaksi</h3>
                      </div>
                      <ul className="space-y-1.5">
                        {selected.action_items.map((a, i) => (
                          <li key={i} className="text-sm text-brand-text">{i + 1}. {a}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {selected.draft_response && (
                    <div>
                      <div className="flex items-center gap-2 mb-2">
                        <ClipboardPen size={17} className="text-primary-600" />
                        <h3 className="font-bold text-brand-text">Vastausluonnos</h3>
                      </div>
                      <div className="rounded-xl bg-brand-bg border border-brand-border p-4 text-sm text-brand-text leading-relaxed whitespace-pre-wrap">
                        {selected.draft_response}
                      </div>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
