import { useState, useRef, FormEvent } from 'react';
import { useAuth } from '@/contexts/AuthContext';
import { supabase, FREE_DAILY_LIMIT, getDailyUsage } from '@/lib/supabase';
import { extractTextFromFile } from '@/lib/extract';
import {
  Upload, FileText, Loader2, Sparkles, ListChecks, ClipboardPen,
  ArrowRight, AlertCircle, CheckCircle2, Clock, LogOut, History, X,
} from 'lucide-react';

interface AnalyzeResult {
  explanation: string;
  key_points: string[];
  action_items: string[];
  draft_response: string;
}

export default function Dashboard({ onShowHistory }: { onShowHistory: () => void }) {
  const { user, signOut } = useAuth();
  const [text, setText] = useState('');
  const [filename, setFilename] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [result, setResult] = useState<AnalyzeResult | null>(null);
  const [usageToday, setUsageToday] = useState<number>(0);
  const [usageLoaded, setUsageLoaded] = useState(false);
  const [extracting, setExtracting] = useState(false);
  const [extractError, setExtractError] = useState<string | null>(null);
  const fileRef = useRef<HTMLInputElement>(null);

  if (user && !usageLoaded) {
    getDailyUsage(user.id).then((n) => {
      setUsageToday(n);
      setUsageLoaded(true);
    });
  }

  async function handleFile(e: React.ChangeEvent<HTMLInputElement>) {
    const file = e.target.files?.[0];
    if (!file) return;
    setFilename(file.name);
    setExtractError(null);
    setExtracting(true);
    try {
      const extracted = await extractTextFromFile(file);
      if (!extracted.trim()) {
        setExtractError('Tiedostosta ei löytynyt tekstiä. Yritä toista tiedostoa.');
      } else {
        setText(extracted.slice(0, 12000));
      }
    } catch {
      setExtractError('Tiedoston lukeminen epäonnistui. Yritä toista tiedostoa.');
    } finally {
      setExtracting(false);
    }
  }

  function clearFile() {
    setFilename(null);
    setText('');
    setExtractError(null);
    if (fileRef.current) fileRef.current.value = '';
  }

  async function handleAnalyze(e: FormEvent) {
    e.preventDefault();
    if (!text.trim() || !user) return;
    setError(null);
    setResult(null);
    setLoading(true);
    try {
      const apiUrl = `${import.meta.env.VITE_SUPABASE_URL}/functions/v1/analyze-document`;
      const res = await fetch(apiUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${import.meta.env.VITE_SUPABASE_ANON_KEY}`,
        },
        body: JSON.stringify({ text, filename, user_id: user.id }),
      });
      if (!res.ok) {
        const body = await res.json().catch(() => ({}));
        throw new Error(body.error || `Pyyntö epäonnistui (${res.status})`);
      }
      const data = await res.json();
      if (!data.explanation) throw new Error('Virheellinen vastaus tekoälyltä.');
      setResult(data);
      const n = await getDailyUsage(user.id);
      setUsageToday(n);
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Tuntematon virhe.');
    } finally {
      setLoading(false);
    }
  }

  const remaining = FREE_DAILY_LIMIT - usageToday;

  return (
    <div className="min-h-screen gradient-hero">
      {/* Top bar */}
      <header className="sticky top-0 z-20 bg-white/90 backdrop-blur-md border-b border-brand-border">
        <div className="w-full max-w-[1120px] mx-auto px-5 flex items-center justify-between h-16">
          <div className="flex items-center gap-2">
            <div className="w-9 h-9 rounded-xl bg-primary-600 flex items-center justify-center">
              <Sparkles size={18} className="text-white" />
            </div>
            <span className="font-extrabold text-brand-text">LomakeApu AI</span>
          </div>
          <div className="flex items-center gap-3">
            <button
              onClick={onShowHistory}
              className="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold text-brand-text border border-brand-border bg-white hover:border-primary-600 hover:text-primary-600 transition-all"
            >
              <History size={16} /> Historia
            </button>
            <button
              onClick={signOut}
              className="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-semibold text-brand-muted hover:text-red-600 transition-colors"
            >
              <LogOut size={16} /> Kirjaudu ulos
            </button>
          </div>
        </div>
      </header>

      <main className="w-full max-w-[1120px] mx-auto px-5 py-10">
        <div className="mb-6">
          <h1 className="text-2xl md:text-[2rem] font-extrabold text-brand-text mb-1">
            Analysoi asiakirja
          </h1>
          <p className="text-brand-muted">
            Liitä teksti tai lataa tiedosto — saat selityksen selkosuomeksi muutamassa sekunnissa.
          </p>
        </div>

        {/* Usage banner */}
        <div className="flex items-center gap-2 mb-5 text-sm">
          <Clock size={15} className="text-primary-600" />
          <span className="text-brand-muted">
            Ilmaista käyttöä jäljellä tänään:{' '}
            <span className="font-bold text-brand-text">
              {Math.max(0, remaining)} / {FREE_DAILY_LIMIT}
            </span>
          </span>
        </div>

        <div className="grid lg:grid-cols-2 gap-6">
          {/* Input */}
          <div className="rounded-card bg-white border border-brand-border shadow-card p-6">
            <form onSubmit={handleAnalyze} className="flex flex-col h-full">
              <div className="flex items-center justify-between mb-3">
                <label className="text-sm font-semibold text-brand-text">Asiakirjan teksti</label>
                <button
                  type="button"
                  onClick={() => fileRef.current?.click()}
                  className="inline-flex items-center gap-1.5 text-xs font-semibold text-primary-600 hover:text-primary-700 transition-colors"
                >
                  <Upload size={14} /> Lataa tiedosto
                </button>
                <input
                  ref={fileRef}
                  type="file"
                  accept=".txt,.md,.csv,.pdf,image/*"
                  onChange={handleFile}
                  className="hidden"
                />
              </div>
              {extracting && (
                <div className="mb-3 flex items-center gap-2 text-xs text-primary-600 bg-primary-50 rounded-lg px-3 py-2 w-fit">
                  <Loader2 size={13} className="animate-spin" /> Luetaan tiedostoa...
                </div>
              )}
              {extractError && !extracting && (
                <div className="mb-3 flex items-center gap-2 text-xs text-red-600 bg-red-50 rounded-lg px-3 py-2 w-fit">
                  <AlertCircle size={13} /> {extractError}
                </div>
              )}
              {filename && !extracting && (
                <div className="mb-3 inline-flex items-center gap-2 text-xs text-brand-muted bg-brand-bg rounded-lg px-3 py-1.5 w-fit">
                  <FileText size={13} /> {filename}
                  <button type="button" onClick={clearFile} className="ml-1 text-brand-muted hover:text-red-600 transition-colors">
                    <X size={13} />
                  </button>
                </div>
              )}
              <textarea
                value={text}
                onChange={(e) => setText(e.target.value)}
                placeholder="Liitä tähän asiakirjan, kirjeen tai lomakkeen teksti..."
                className="flex-1 min-h-[260px] w-full p-4 rounded-xl border border-brand-border bg-brand-bg text-brand-text placeholder:text-brand-muted/60 focus:outline-none focus:border-primary-500 focus:ring-2 focus:ring-primary-100 transition-all resize-y text-sm leading-relaxed"
              />
              <button
                type="submit"
                disabled={loading || !text.trim()}
                className="mt-4 inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full bg-primary-600 text-white font-bold text-[0.97rem] hover:bg-primary-700 transition-all duration-150 shadow-btn disabled:opacity-50"
              >
                {loading ? (
                  <><Loader2 size={18} className="animate-spin" /> Analysoin...</>
                ) : (
                  <>Analysoi <ArrowRight size={18} /></>
                )}
              </button>
            </form>
          </div>

          {/* Result */}
          <div className="rounded-card bg-white border border-brand-border shadow-card p-6">
            {loading && (
              <div className="flex flex-col items-center justify-center h-full text-brand-muted py-16">
                <Loader2 size={32} className="animate-spin text-primary-600 mb-3" />
                <p className="text-sm">Tekoäly lukee asiakirjaa...</p>
              </div>
            )}

            {error && !loading && (
              <div className="flex items-start gap-3 bg-red-50 border border-red-200 rounded-xl p-4">
                <AlertCircle size={20} className="text-red-600 shrink-0 mt-0.5" />
                <div>
                  <p className="font-semibold text-red-700 text-sm">Analyysi epäonnistui</p>
                  <p className="text-red-600 text-sm mt-0.5">{error}</p>
                </div>
              </div>
            )}

            {!loading && !error && !result && (
              <div className="flex flex-col items-center justify-center h-full text-center py-16">
                <div className="w-14 h-14 rounded-2xl bg-primary-50 flex items-center justify-center mb-3">
                  <Sparkles size={26} className="text-primary-600" />
                </div>
                <p className="text-brand-muted text-sm max-w-xs">
                  Analyysitulos näkyy tässä. Liitä teksti vasemmalle ja paina "Analysoi".
                </p>
              </div>
            )}

            {result && !loading && (
              <div className="space-y-5">
                <div>
                  <div className="flex items-center gap-2 mb-2">
                    <Sparkles size={17} className="text-primary-600" />
                    <h3 className="font-bold text-brand-text">Selkosuomi</h3>
                  </div>
                  <p className="text-sm text-brand-text leading-relaxed whitespace-pre-wrap">
                    {result.explanation}
                  </p>
                </div>

                {result.key_points.length > 0 && (
                  <div>
                    <div className="flex items-center gap-2 mb-2">
                      <ListChecks size={17} className="text-primary-600" />
                      <h3 className="font-bold text-brand-text">Avainkohdat</h3>
                    </div>
                    <ul className="space-y-1.5">
                      {result.key_points.map((p, i) => (
                        <li key={i} className="flex items-start gap-2 text-sm text-brand-text">
                          <CheckCircle2 size={15} className="text-primary-600 mt-0.5 shrink-0" />
                          {p}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {result.action_items.length > 0 && (
                  <div>
                    <div className="flex items-center gap-2 mb-2">
                      <ArrowRight size={17} className="text-primary-600" />
                      <h3 className="font-bold text-brand-text">Mitä tehdä seuraavaksi</h3>
                    </div>
                    <ul className="space-y-1.5">
                      {result.action_items.map((a, i) => (
                        <li key={i} className="flex items-start gap-2 text-sm text-brand-text">
                          <span className="w-5 h-5 rounded-full bg-primary-50 text-primary-600 text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                            {i + 1}
                          </span>
                          {a}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}

                {result.draft_response && (
                  <div>
                    <div className="flex items-center gap-2 mb-2">
                      <ClipboardPen size={17} className="text-primary-600" />
                      <h3 className="font-bold text-brand-text">Vastausluonnos</h3>
                    </div>
                    <div className="rounded-xl bg-brand-bg border border-brand-border p-4 text-sm text-brand-text leading-relaxed whitespace-pre-wrap">
                      {result.draft_response}
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      </main>
    </div>
  );
}
